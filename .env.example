# Copy to .env and fill in. Never commit .env (public repo).

# Jev / TypeSafe: judgments at load time (live loads, your own logs, --fresh). Without it: problems by log level only.
TYPESAFE_API_KEY=

# Our own agent + the evaluation (not needed for Claude Code with the MCP server)
ANTHROPIC_API_KEY=

# Optional: Gemini embeddings at load time (semantic pattern search). Without it: word search only.
GOOGLE_API_KEY=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=making-sense-of-logs
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # our account is EU; US default = https://api.smith.langchain.com

# Web search (Tavily MCP, coding agent only)
TAVILY_API_KEY=

# Agent LLM (LangChain init_chat_model id)
AGENT_MODEL=anthropic:claude-sonnet-5-5

# SereneDB (local docker)
PGHOST=localhost
PGPORT=7890
PGUSER=postgres
PGDATABASE=postgres
