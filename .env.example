# Copy to .env and fill in. Never commit .env (public repo).

# Jev / TypeSafe (typed judgments; also registered in SereneDB by docker/secrets.sh)
TYPESAFE_API_KEY=

# Agent + explanation LLM (strong model)
ANTHROPIC_API_KEY=

# Optional: Gemini (embeddings / ai_* functions in SQL)
GOOGLE_API_KEY=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=making-sense-of-logs

# Agent LLM (LangChain init_chat_model id)
AGENT_MODEL=anthropic:claude-opus-5-5

# SereneDB (local docker)
PGHOST=localhost
PGPORT=7890
PGUSER=postgres
PGDATABASE=postgres
