# secrets
.env
.env.*
!.env.example

# data/: config/ (inputs, committed), jev/ (committed Jev outputs of the base corpus + small catalog sets),
# raw/ (downloaded logs: never committed). Fresh machine: `uv run python -m loader load base --fresh` judges live.
data/raw/
data/*.csv
data/*.parquet
src/sql/gen/

# third-party doc dumps (re-fetch with scripts/refresh_docs.sh; use the typesafe-docs MCP instead)

# python / tooling
.venv/
__pycache__/
*.pyc
.DS_Store
runs/**/cache/
*.log

# heldout eval data: never visible to Claude, shared privately (plan 001)
eval/heldout/

# agent run outputs (answer cards + evidence ledgers, plan 007)
runs/agent/
runs/sessions/
runs/cc_ab/

# Office lock files
~$*
